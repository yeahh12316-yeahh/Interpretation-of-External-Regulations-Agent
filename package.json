{
  "name": "external-regulation-agent",
  "version": "1.0.0",
  "description": "静态外规解读工作流前端",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "benchmark": "tsx scripts/run-benchmark.ts",
    "scan:build": "node scripts/scan-build-secrets.mjs dist",
    "scan:secrets": "tsx scripts/scan-secrets.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:production": "playwright test --config=playwright.production.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.19.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.19.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "@react-pdf/renderer": "^4.6.0",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "dexie": "^4.4.4",
    "docx": "^9.7.1",
    "file-saver": "^2.0.5",
    "mammoth": "^1.12.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "^10.8.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "5.7.3",
    "vite": "6.3.5",
    "vitest": "3.1.4"
  }
}
